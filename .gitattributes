# Normaliza finales de línea para que Windows y Linux no marquen archivos
# como modificados por CRLF. Los CSV limpios de CENTA y las migraciones son
# sensibles a esto (ver docs/Estado_Proyecto_Pt2.txt, Propuestas).
* text=auto eol=lf

*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.prisma text eol=lf
*.sql text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Scripts de Windows conservan su final de línea.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: Git no debe convertirlos ni mostrar diffs de texto.
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
