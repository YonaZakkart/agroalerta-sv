// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// Parte 1 — Autenticación
model Usuario {
  id                      Int          @id @default(autoincrement())
  nombres                 String       @db.VarChar(100)
  apellidos               String       @db.VarChar(100)
  correo                  String       @unique @db.VarChar(255)
  contrasenaHash          String       @map("contrasena_hash") @db.VarChar(255)
  duiHash                 String       @unique @map("dui_hash") @db.Char(64)
  distritoId              Int          @map("distrito_id")
  distrito                Distrito     @relation(fields: [distritoId], references: [id])
  verificado              Boolean      @default(false)
  tokenVerificacion       String?      @unique @map("token_verificacion") @db.VarChar(64)
  tokenVerificacionExpira DateTime?    @map("token_verificacion_expira")
  fechaRegistro           DateTime     @default(now()) @map("fecha_registro")
  siembras                Siembra[]
  estimaciones            Estimacion[]

  @@map("usuarios")
}

// Parte 2 — Viabilidad (datos de referencia CENTA)
enum TipoCapa {
  POTENCIAL // valor mayor = mejor
  RIESGO // valor mayor = peor
}

model Municipio {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique @db.VarChar(100)
  distritos Distrito[]

  @@map("municipios")
}

model Distrito {
  // Código CENTA (Id_Muni de los exports, 1301 a 1326). Llave natural, sin autoincrement.
  id                Int                @id
  nombre            String             @db.VarChar(100)
  nombreNormalizado String             @unique @map("nombre_normalizado") @db.VarChar(100)
  municipioId       Int                @map("municipio_id")
  latitud           Decimal?           @db.Decimal(9, 6)
  longitud          Decimal?           @db.Decimal(9, 6)
  municipio         Municipio          @relation(fields: [municipioId], references: [id])
  areas             AreaClase[]
  usuarios          Usuario[]
  condicion         CondicionDistrito?
  siembras          Siembra[]

  @@map("distritos")
}

model Capa {
  id      Int         @id @default(autoincrement())
  codigo  String      @unique @db.VarChar(50)
  nombre  String      @db.VarChar(100)
  tipo    TipoCapa
  cultivo String?     @db.VarChar(50)
  clases  ClaseCapa[]

  @@map("capas")
}

model ClaseCapa {
  id     Int         @id @default(autoincrement())
  capaId Int         @map("capa_id")
  valor  Int
  nombre String      @db.VarChar(50)
  capa   Capa        @relation(fields: [capaId], references: [id])
  areas  AreaClase[]

  @@unique([capaId, valor])
  @@map("clases_capa")
}

model AreaClase {
  id              Int       @id @default(autoincrement())
  distritoId      Int       @map("distrito_id")
  claseId         Int       @map("clase_id")
  areaHa          Decimal   @map("area_ha") @db.Decimal(12, 3)
  fuente          String    @db.VarChar(50)
  fechaExtraccion DateTime  @map("fecha_extraccion") @db.Date
  distrito        Distrito  @relation(fields: [distritoId], references: [id])
  clase           ClaseCapa @relation(fields: [claseId], references: [id])

  @@unique([distritoId, claseId])
  @@map("areas_clase")
}

// ------------------------------------------------------------
// Parte 3 — Clima (3-B): última condición por distrito
// ------------------------------------------------------------
enum CondicionClima {
  SEQUIA
  EXCESO_LLUVIA
  INVIERNO_ACEPTABLE
}

enum NivelSequia {
  DEBIL
  MODERADA
  FUERTE
  SEVERA
}

model CondicionDistrito {
  distritoId            Int             @id @map("distrito_id")
  condicion             CondicionClima? // null = sin evaluación (fuera de época)
  nivelSequia           NivelSequia?    @map("nivel_sequia")
  diasSecosConsecutivos Int             @map("dias_secos_consecutivos")
  acumulado30Mm         Decimal?        @map("acumulado_30_mm") @db.Decimal(8, 2)
  normal30Mm            Decimal?        @map("normal_30_mm") @db.Decimal(8, 2)
  razon30               Decimal?        @db.Decimal(6, 3)
  fechaDatos            DateTime        @map("fecha_datos") @db.Date
  actualizadoEn         DateTime        @map("actualizado_en")
  condicionDesde        DateTime?       @map("condicion_desde")

  distrito Distrito @relation(fields: [distritoId], references: [id])

  @@map("condiciones_distrito")
}

// ------------------------------------------------------------
// Parte 4 — Siembra (4-A)
// ------------------------------------------------------------
enum Cultivo {
  MAIZ
  FRIJOL
  MAICILLO // CENTA lo llama "sorgo"; el proyecto usa "maicillo" (D7)
}

enum EstadoSiembra {
  POR_SEMBRAR
  SEMBRADO
}

enum UnidadSemilla {
  LIBRAS
  BOLSAS
}

model Siembra {
  id           Int           @id @default(autoincrement())
  usuarioId    Int           @map("usuario_id")
  distritoId   Int           @map("distrito_id")
  cultivo      Cultivo
  estado       EstadoSiembra
  fechaSiembra DateTime      @map("fecha_siembra") @db.Date // cuándo sembró o cuándo planea sembrar, según estado
  areaMz       Decimal       @map("area_mz") @db.Decimal(8, 2)

  cantidadSemilla Decimal?       @map("cantidad_semilla") @db.Decimal(10, 2)
  unidadSemilla   UnidadSemilla? @map("unidad_semilla")

  alquilaTerreno Boolean @default(false) @map("alquila_terreno")
  usaMaquinaria  Boolean @default(false) @map("usa_maquinaria")
  usaRiego       Boolean @default(false) @map("usa_riego")

  // Lo que declara el agricultor (incluye todo). El desglose es opcional.
  inversionTotalUsd  Decimal  @map("inversion_total_usd") @db.Decimal(10, 2)
  costoSemillaUsd    Decimal? @map("costo_semilla_usd") @db.Decimal(10, 2)
  costoAlquilerUsd   Decimal? @map("costo_alquiler_usd") @db.Decimal(10, 2)
  costoMaquinariaUsd Decimal? @map("costo_maquinaria_usd") @db.Decimal(10, 2)
  costoRiegoUsd      Decimal? @map("costo_riego_usd") @db.Decimal(10, 2)
  costoOtrosUsd      Decimal? @map("costo_otros_usd") @db.Decimal(10, 2)

  creadoEn DateTime @default(now()) @map("creado_en")

  usuario      Usuario      @relation(fields: [usuarioId], references: [id])
  distrito     Distrito     @relation(fields: [distritoId], references: [id])
  estimaciones Estimacion[]

  @@index([usuarioId, creadoEn])
  @@map("siembras")
}

// ------------------------------------------------------------
// Parte 5 — Estimación (5-D)
// ------------------------------------------------------------
enum NivelRiesgo {
  VERDE
  AMARILLO
  ROJO
}

// Reporte histórico de una estimación. Guarda una instantánea de la siembra,
// la proyección de 5-B y la recomendación de 5-C para no recalcular al leer.
model Estimacion {
  id         Int @id @default(autoincrement())
  siembraId  Int @map("siembra_id")
  usuarioId  Int @map("usuario_id")
  // Snapshot del distrito: no FK para conservar el reporte aunque cambie el catálogo.
  distritoId Int @map("distrito_id")

  cultivo      Cultivo
  estado       EstadoSiembra
  areaMz       Decimal       @map("area_mz") @db.Decimal(8, 2)
  fechaSiembra DateTime      @map("fecha_siembra") @db.Date

  condicion     CondicionClima?
  nivelSequia   NivelSequia?
  fechaDatos    DateTime?       @map("fecha_datos") @db.Date
  actualizadoEn DateTime?       @map("actualizado_en")

  rendimientoBaseQqPorMz     Decimal @map("rendimiento_base_qq_por_mz") @db.Decimal(8, 2)
  factorClimatico            Decimal @map("factor_climatico") @db.Decimal(5, 3)
  rendimientoEstimadoQqPorMz Decimal @map("rendimiento_estimado_qq_por_mz") @db.Decimal(8, 2)
  produccionEstimadaQq       Decimal @map("produccion_estimada_qq") @db.Decimal(12, 2)
  precioVentaQqUsd           Decimal @map("precio_venta_qq_usd") @db.Decimal(10, 2)
  ingresoEstimadoUsd         Decimal @map("ingreso_estimado_usd") @db.Decimal(12, 2)

  nivelRiesgo NivelRiesgo @map("nivel_riesgo")
  titulo      String      @db.VarChar(100)
  mensaje     String      @db.VarChar(500)
  motivos     Json
  viabilidad  Json?
  supuestos   Json

  calculadoEn DateTime @default(now()) @map("calculado_en")

  siembra Siembra @relation(fields: [siembraId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, calculadoEn])
  @@index([siembraId, calculadoEn])
  @@map("estimaciones")
}
