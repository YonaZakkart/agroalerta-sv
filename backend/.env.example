DATABASE_URL="mysql://agroalerta:agroalerta@localhost:3306/agroalerta"
DB_HOST=localhost
DB_PORT=3306
DB_USER=agroalerta
DB_PASSWORD=agroalerta
DB_NAME=agroalerta
# Obligatorio, mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No rotar una vez en uso: invalida la detección de DUI duplicados.
DUI_PEPPER=
# Solo desarrollo: devuelve el token de verificación en la respuesta (aún no hay envío de correo).
# Debe ser false o no existir en cualquier entorno real; con NODE_ENV=production el backend no arranca si es true.
EXPONER_TOKEN_VERIFICACION=true
# Obligatorio, mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Segundos ("7200") o duración compacta ("2h", "7d", "30m"). Por defecto: 2h.
JWT_EXPIRES_IN=2h