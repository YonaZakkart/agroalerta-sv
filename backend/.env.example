DATABASE_URL="postgresql://usuario:clave@host-pooler.neon.tech/agroalerta?sslmode=require"
# Solo para migraciones (conexión directa, sin -pooler). No la usa la app en runtime.
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@host.neon.tech/agroalerta?sslmode=require"
# Obligatorio, mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No rotar una vez en uso: invalida la detección de DUI duplicados.
DUI_PEPPER=
# Solo desarrollo: devuelve el token de verificación en la respuesta (aún no hay envío de correo).
# Debe ser false o no existir en cualquier entorno real; con NODE_ENV=production el backend no arranca si es true.
EXPONER_TOKEN_VERIFICACION=true
# MVP sin proveedor de correo: true crea la cuenta ya verificada. En producción, usar true solo mientras no haya SMTP.
VERIFICACION_AUTOMATICA=false
# Obligatorio, mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Segundos ("7200") o duración compacta ("2h", "7d", "30m"). Por defecto: 2h.
JWT_EXPIRES_IN=2h
# Opcional. Orígenes permitidos por CORS, separados por comas (p. ej. http://localhost:4200).
# Vacío = sin CORS (el frontend de desarrollo usa el proxy /api, mismo origen).
CORS_ORIGINS=