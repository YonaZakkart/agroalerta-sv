DATABASE_URL="mysql://agroalerta:agroalerta@localhost:3306/agroalerta"
DB_HOST=localhost
DB_PORT=3306
DB_USER=agroalerta
DB_PASSWORD=agroalerta
DB_NAME=agroalerta
# Obligatorio. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No rotar una vez en uso: invalida la detección de DUI duplicados.
DUI_PEPPER=
# Solo desarrollo: devuelve el token de verificación en la respuesta (aún no hay envío de correo).
# Debe ser false o no existir en cualquier entorno real.
EXPONER_TOKEN_VERIFICACION=true
# Obligatorio, mínimo 32 caracteres. Generar con el mismo comando.
JWT_SECRET=
JWT_EXPIRES_IN=2h