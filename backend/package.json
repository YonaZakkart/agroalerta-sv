{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run pruebas:config && npm run pruebas:http && npm run pruebas:http-seguridad && npm run pruebas:eventos && npm run pruebas:viabilidad && npm run pruebas:clima-validacion && npm run pruebas:clima-endpoint && npm run pruebas:clima-job && npm run pruebas:clima-errores && npm run pruebas:normales && npm run pruebas:condicion && npm run clima:pruebas && npm run clima:pruebas-clasificacion",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "datos:limpiar": "ts-node-dev --transpile-only src/viabilidad/datos/limpiar-centa.ts",
    "datos:cargar": "ts-node-dev --transpile-only src/viabilidad/datos/cargar-centa.ts",
    "pruebas:config": "ts-node-dev --transpile-only src/config/puerto.pruebas.ts && ts-node-dev --transpile-only src/config/entorno.pruebas.ts",
    "pruebas:http": "ts-node-dev --transpile-only src/comun/http-errores.pruebas.ts",
    "pruebas:http-seguridad": "ts-node-dev --transpile-only src/comun/http-seguridad.pruebas.ts && ts-node-dev --transpile-only src/comun/rate-limit.pruebas.ts && ts-node-dev --transpile-only src/comun/salud.pruebas.ts && ts-node-dev --transpile-only src/comun/cierre.pruebas.ts",
    "pruebas:eventos": "ts-node-dev --transpile-only src/events/emitir.pruebas.ts",
    "pruebas:viabilidad": "ts-node-dev --transpile-only src/viabilidad/origen.pruebas.ts",
    "pruebas:clima-validacion": "ts-node-dev --transpile-only src/clima/distritos-solicitados.pruebas.ts",
    "pruebas:clima-endpoint": "ts-node-dev --transpile-only src/clima/condicion.dto.pruebas.ts",
    "pruebas:clima-job": "ts-node-dev --transpile-only src/clima/job.pruebas.ts",
    "pruebas:clima-errores": "ts-node-dev --transpile-only src/clima/errores-http.pruebas.ts",
    "pruebas:normales": "ts-node-dev --transpile-only src/clima/normales-archivo.pruebas.ts",
    "clima:pruebas": "ts-node-dev --transpile-only src/clima/clima.pruebas.ts",
    "clima:pruebas-clasificacion": "ts-node-dev --transpile-only src/clima/clasificacion.pruebas.ts",
    "clima:probar": "ts-node-dev --transpile-only src/clima/probar-open-meteo.ts",
    "clima:clasificar": "ts-node-dev --transpile-only src/clima/clasificar-probar.ts",
    "clima:normales": "ts-node-dev --transpile-only src/clima/generar-normales.ts",
    "pruebas:condicion": "ts-node-dev --transpile-only src/clima/condicion-cambio.pruebas.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "prisma": "^7.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "argon2@0.45.1": true,
    "prisma@7.10.0": true
  }
}
